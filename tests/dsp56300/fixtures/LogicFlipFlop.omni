# Nord Modular G2 - LogicFlipFlop (T-Flip-Flop / Toggle Latch)
# Clean-Room MIT Implementation
init:
    state = 0.0
    prevTrig = 0.0

sample:
    if in1 > 0.5 and prevTrig <= 0.5:
        if state > 0.5:
            state = 0.0
        else:
            state = 1.0
    prevTrig = in1
    out1 = state
