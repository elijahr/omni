# Nord Modular G2 - PMDriver (Phase Modulation / FM Operator Driver)
# Clean-Room MIT Implementation
params:
    ratio {0.5, 0.05, 1.0}
    index {0.5, 0.0, 1.0}

init:
    phase = 0.0

sample:
    r = ratio
    if r == 0.0:
        r = 0.5
    incr = in1 * r
    if incr == 0.0:
        incr = 0.005
    phase = (phase + incr) % 1.0
    modSig = sin(phase + in2 * index)
    out1 = modSig
