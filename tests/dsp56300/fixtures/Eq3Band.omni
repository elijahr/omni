# Nord Modular G2 - Eq3Band (3-Band Parametric Equalizer)
# Clean-Room MIT Implementation
params:
    low {0.5, 0.0, 1.0}
    mid {0.5, 0.0, 1.0}
    high {0.5, 0.0, 1.0}

init:
    lp = 0.0
    hp = 0.0

sample:
    lp = lp + 0.1 * (in1 - lp)
    hp = in1 - (hp + 0.5 * (in1 - hp))
    mp = in1 - lp - hp
    out1 = lp * low + mp * mid + hp * high
